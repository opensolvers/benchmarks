+/* True if EXT is a standard extension this compiler knows about.  Used by
+   the -march=native driver to drop kernel-reported names that would make
+   -march= fail.  */
+
+bool
+riscv_ext_is_known_p (const char *ext)
+{
+  const struct riscv_ext_version *ext_ver;
+
+  for (ext_ver = &riscv_ext_version_table[0];
+       ext_ver->name != NULL; ++ext_ver)
+    if (strcmp (ext_ver->name, ext) == 0)
+      return true;
+
+  return false;
+}
