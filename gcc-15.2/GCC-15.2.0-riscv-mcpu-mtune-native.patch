# GCC 15.2.0 RISC-V -mcpu=native / -mtune=native follow-on.
# REQUIRES: GCC-15.2.0-riscv-march-native.patch applied first.
# Recommended full EasyBuild order (SpacemiT first so CPU names exist):
#   GCC-15.2.0-spacemit-x60.patch
#   GCC-15.2.0-spacemit-x100-a100.patch
#   GCC-15.2.0-riscv-march-native.patch
#   GCC-15.2.0-riscv-mcpu-mtune-native.patch
# CORE macro stays 3-arg; SpacemiT and native patches are independent.
# Apply with: patch -p1 < this-file
#
--- a/gcc/config/riscv/driver-riscv.cc
+++ b/gcc/config/riscv/driver-riscv.cc
@@ -337,10 +337,100 @@
   return xstrdup (isa.c_str ());
 }
 
+/* Hardcoded identification registers.  Keeps RISCV_CORE 3-arg so SpacemiT
+   patches still apply.  Names must exist as -mtune/-mcpu values in this
+   compiler (apply SpacemiT X60 + X100/A100 patches before relying on
+   spacemit-* native detection).  */
+
+struct riscv_core_id
+{
+  const char *name;
+  struct riscv_cpuid id;
+};
+
+static const struct riscv_core_id riscv_core_ids[] = {
+  /* SiFive (stock GCC 15.2 names).  */
+  { "sifive-u74",
+    riscv_cpuid (0x489, 0x8000000000000007ULL, 0x4210427ULL) },
+  { "sifive-p550",
+    riscv_cpuid (0x489, 0x8000000000000008ULL, 0x6220425ULL) },
+  /* SpacemiT (requires SpacemiT GCC patches).  */
+  { "spacemit-x60",
+    riscv_cpuid (0x710, 0x8000000058000001ULL, 0x1000000049772200ULL) },
+  { "spacemit-x100",
+    riscv_cpuid (0x710, 0x8000000058000002ULL, 0x33d8a600ULL) },
+  { "spacemit-a100",
+    riscv_cpuid (0x710, 0x8000000041000002ULL, 0x10000000d5686200ULL) },
+};
+
 static const char *
-riscv_native_tune (void)
+riscv_core_from_cpuid (const struct riscv_cpuid &id)
 {
+  for (size_t i = 0; i < ARRAY_SIZE (riscv_core_ids); i++)
+    if (riscv_core_ids[i].id.match (id))
+      return riscv_core_ids[i].name;
+
   return NULL;
+}
+
+static bool
+riscv_cpuid_from_pairs (const struct riscv_hwprobe *pairs, size_t npairs,
+			struct riscv_cpuid &id)
+{
+  id = riscv_cpuid (riscv_hwprobe_value (pairs, npairs,
+					 RISCV_HWPROBE_KEY_MVENDORID),
+		    riscv_hwprobe_value (pairs, npairs,
+					 RISCV_HWPROBE_KEY_MARCHID),
+		    riscv_hwprobe_value (pairs, npairs,
+					 RISCV_HWPROBE_KEY_MIMPID));
+
+  return id.valid_p ();
+}
+
+static bool
+riscv_cpuid_from_hwprobe (struct riscv_cpuid &id)
+{
+  struct riscv_hwprobe pairs[] = {
+    { RISCV_HWPROBE_KEY_MVENDORID, 0 },
+    { RISCV_HWPROBE_KEY_MARCHID, 0 },
+    { RISCV_HWPROBE_KEY_MIMPID, 0 }
+  };
+  size_t npairs = ARRAY_SIZE (pairs);
+
+  if (riscv_hwprobe_affinity (pairs, npairs)
+      && riscv_cpuid_from_pairs (pairs, npairs, id))
+    return true;
+
+  return (riscv_hwprobe_this_core (pairs, npairs)
+	  && riscv_cpuid_from_pairs (pairs, npairs, id));
+}
+
+static bool
+riscv_cpuid_from_cpuinfo (struct riscv_cpuid &id)
+{
+  struct riscv_cpuinfo info;
+
+  if (!riscv_cpuinfo (&info))
+    return false;
+
+  id = info.id;
+
+  return id.valid_p ();
+}
+
+static const char *
+riscv_native_tune (void)
+{
+  struct riscv_cpuid id;
+  const char *core;
+
+  if ((riscv_cpuinfo_forced () || !riscv_cpuid_from_hwprobe (id))
+      && !riscv_cpuid_from_cpuinfo (id))
+    return NULL;
+
+  core = riscv_core_from_cpuid (id);
+
+  return core != NULL ? xstrdup (core) : NULL;
 }
 
