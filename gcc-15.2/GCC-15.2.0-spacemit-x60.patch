From: OpenSolvers <opensolvers@example.com>
Subject: [PATCH] RISC-V: SpacemiT X60 tune + xsmtvdot + measurement Layer B for GCC 15.2.0

EasyBuild/GCCcore single patch for stock GCC 15.2.0.

Composition (Layer A then Layer B; type=shadd deferred):
  Layer A: 0001 tune/DFA + 0002 xsmtvdot (table form)
  Layer B: 0001, 0001b, 0002, 0003, 0005(clmul-only), 0004, 0006

Semantics: atomic@12, memory_cost=4, vector_cost wired, clmul@2; no type=shadd.

Apply from the gcc-15.2.0 source root with: patch -p1 < thisfile

diff -ruN a/gcc/common/config/riscv/riscv-common.cc b/gcc/common/config/riscv/riscv-common.cc
--- a/gcc/common/config/riscv/riscv-common.cc
+++ b/gcc/common/config/riscv/riscv-common.cc
@@ -227,6 +227,9 @@
   {"ssstateen", "zicsr"},
   {"sstc", "zicsr"},
 
+  {"xsmtvdot", "zve32x"},
+  {"xsmtvdotii", "xsmtvdot"},
+
   {"xsfvcp", "zve32x"},
 
   {NULL, NULL}
@@ -434,6 +437,9 @@
   {"xtheadsync", ISA_SPEC_CLASS_NONE, 1, 0},
   {"xtheadvector", ISA_SPEC_CLASS_NONE, 1, 0},
 
+  {"xsmtvdot", ISA_SPEC_CLASS_NONE, 1, 0},
+  {"xsmtvdotii", ISA_SPEC_CLASS_NONE, 1, 0},
+
   {"xventanacondops", ISA_SPEC_CLASS_NONE, 1, 0},
 
   {"xsfvcp",   ISA_SPEC_CLASS_NONE, 1, 0},
@@ -1770,6 +1776,9 @@
   RISCV_EXT_FLAG_ENTRY ("xtheadvector",  x_target_flags, MASK_FULL_V),
   RISCV_EXT_FLAG_ENTRY ("xtheadvector",  x_target_flags, MASK_VECTOR),
 
+  RISCV_EXT_FLAG_ENTRY ("xsmtvdot",   x_riscv_xsmt_subext, MASK_XSMTVDOT),
+  RISCV_EXT_FLAG_ENTRY ("xsmtvdotii", x_riscv_xsmt_subext, MASK_XSMTVDOTII),
+
   RISCV_EXT_FLAG_ENTRY ("xventanacondops", x_riscv_xventana_subext, MASK_XVENTANACONDOPS),
 
   RISCV_EXT_FLAG_ENTRY ("xsfvcp",   x_riscv_sifive_subext, MASK_XSFVCP),
diff -ruN a/gcc/config/riscv/riscv.cc b/gcc/config/riscv/riscv.cc
--- a/gcc/config/riscv/riscv.cc
+++ b/gcc/config/riscv/riscv.cc
@@ -444,6 +444,21 @@
   &rvv_regmove_vector_cost, /* regmove  */
 };
 
+/* SpacemiT X60 vectorizer costs — OpenSolvers Layer B.
+   Based on generic_vector_cost; scalar mem costs aligned to F3 L1
+   load-chase ~4c.  See patches/0006 / notes/00-status.md.  */
+static const struct cpu_vector_cost spacemit_x60_vector_cost = {
+  1,			    /* scalar_int_stmt_cost  */
+  1,			    /* scalar_fp_stmt_cost  */
+  4,			    /* scalar_load_cost (F3 load-chase ~4c) */
+  2,			    /* scalar_store_cost (conservative) */
+  3,			    /* cond_taken_branch_cost  */
+  1,			    /* cond_not_taken_branch_cost  */
+  &rvv_vls_vector_cost,	    /* vls  */
+  &rvv_vla_vector_cost,	    /* vla  */
+  &rvv_regmove_vector_cost, /* regmove  */
+};
+
 /* Costs to use when optimizing for rocket.  */
 static const struct riscv_tune_param rocket_tune_info = {
   {COSTS_N_INSNS (4), COSTS_N_INSNS (5)},	/* fp_add */
@@ -577,6 +592,27 @@
 };
 
 /* Costs to use when optimizing for a generic ooo profile.  */
+static const struct riscv_tune_param spacemit_x60_tune_info= {
+  {COSTS_N_INSNS (4), COSTS_N_INSNS (4)},	/* fp_add (SF/DF; F3 fadd.d~4) */
+  {COSTS_N_INSNS (4), COSTS_N_INSNS (5)},	/* fp_mul */
+  {COSTS_N_INSNS (15), COSTS_N_INSNS (22)},	/* fp_div */
+  {COSTS_N_INSNS (3), COSTS_N_INSNS (6)},	/* int_mul */
+  {COSTS_N_INSNS (12), COSTS_N_INSNS (20)},	/* int_div */
+  2,						/* issue_rate */
+  3,						/* branch_cost */
+  4,						/* memory_cost */
+  6,						/* fmv_cost */
+  false,					/* slow_unaligned_access */
+  false,					/* vector_unaligned_access */
+  false,					/* use_divmod_expansion */
+  false,					/* overlap_op_by_pieces */
+  RISCV_FUSE_NOTHING,				/* fusible_ops */
+  &spacemit_x60_vector_cost,			/* vector cost */
+  NULL,						/* function_align */
+  NULL,						/* jump_align */
+  NULL,						/* loop_align */
+};
+
 static const struct riscv_tune_param generic_ooo_tune_info = {
   {COSTS_N_INSNS (2), COSTS_N_INSNS (2)},	/* fp_add */
   {COSTS_N_INSNS (5), COSTS_N_INSNS (6)},	/* fp_mul */
@@ -10174,7 +10210,8 @@
 			 unsigned int)
 {
   /* Only do adjustments for the generic out-of-order scheduling model.  */
-  if (!TARGET_VECTOR || riscv_microarchitecture != generic_ooo)
+  if (!TARGET_VECTOR || (riscv_microarchitecture != generic_ooo
+	  && riscv_microarchitecture != spacemit_x60))
     return cost;
 
   if (recog_memoized (insn) < 0)
@@ -10594,6 +10631,8 @@
   const char *tune_string = get_tune_str (opts);
   cpu = riscv_parse_tune (tune_string, false);
   riscv_microarchitecture = cpu->microarchitecture;
+  if (riscv_microarchitecture == spacemit_x60)
+    opts->x_TARGET_ADJUST_LMUL_COST = 1;
   tune_param = opts->x_optimize_size
 		 ? &optimize_size_tune_info
 		 : cpu->tune_param;
