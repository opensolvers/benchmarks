# Shared LJ melt setup for A/B force/energy verify (stock vs lj/cut/rvv).
# Caller sets pair_style before include, or we use a placeholder — see verify.sh.

units           lj
atom_style      atomic
boundary        p p p

lattice         fcc 0.8442
region          box block 0 4 0 4 0 4
create_box      1 box
create_atoms    1 box
mass            1 1.0

velocity        all create 1.44 87287 loop geom

neighbor        0.3 bin
neigh_modify    delay 0 every 1 check yes

# pair_style / pair_coeff set by verify.sh wrappers
# pair_style lj/cut 2.5
# pair_coeff 1 1 1.0 1.0 2.5

fix             1 all nve
fix             2 all langevin 1.0 1.0 10.0 48279

thermo          1
thermo_style    custom step temp pe ke etotal press

# equilibrate briefly so neigh list is non-trivial, then freeze + force eval
run             20
unfix           2
run             0
