// UniformGrid RVV A/B — sized for Orange Pi RV2 (~1–3 min/run)
// Defaults in binary: split+pure+fzyx+fused. Pass --not-fused for SoA collide separate from stream.
// VTK block empty → no VTK writers.

UniformGrid
{
   // cells per block (np=1 → one block; np=4 → four blocks via process grid)
   xCells 64;
   yCells 64;
   zCells 64;

   xWeight 1.0;
   yWeight 1.0;
   zWeight 1.0;

   // total timesteps = outer * inner
   outerTimeSteps 5;
   innerTimeSteps 40; // 200 steps; TimingPool logged each outer

   logToSqlDB  false;
   sqlFile     uniform_grid_bench.sqlite;

   omega 1.4;
   velocity 0.01;
}

VTK
{
}
